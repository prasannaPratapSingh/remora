{
  "name": "backend",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun build --target=bun ./src/app.ts --outdir ./dist",
    "start": "NODE_ENV=production bun ./dist/app.js",
    "fix": "bunx prisma format && bunx prisma validate",
    "migrate": "bunx prisma migrate dev",
    "migrate:prod": "bunx prisma migrate deploy",
    "generate": "bunx prisma generate",
    "worker": "bun src/worker.ts",
    "test": "NODE_ENV=test bun test --timeout 30000",
    "eval": "bun src/modules/evaluation/evaluator.ts",
    "cleanup": "bun src/cron/cleanupExpiredMemories.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@prisma/client": "5",
    "bullmq": "^6.3.19",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "openai": "^7.39.0",
    "pgvector": "^0.3.0",
    "prisma": "5",
    "zod": "^4.6.5"
  }
}
