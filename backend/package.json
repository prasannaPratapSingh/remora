{
  "name": "backend",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun build --target=bun ./src/app.ts --outdir ./dist",
    "start": "bun ./dist/app.js",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "prisma": "^8.0.0-rc.22",
    "zod": "^4.6.5"
  }
}
