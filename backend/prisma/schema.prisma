generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// Remora dashboard account / developer
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  clerkId   String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[] @relation("OrganizationOwner")

  @@map("users")
}

// A developer's company or workspace
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(name: "OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  projects Project[]
  memories Memory[]

  @@index([ownerId])
  @@map("organizations")
}

// An application integrating Remora
model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  apiKeys  ApiKey[]
  memories Memory[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

// Store only the hash of an API key, never its raw secret
model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_keys")
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  INSTRUCTION
  DECISION
  PROFILE
  RELATIONSHIP
  PROJECT_CONTEXT
  BEHAVIOR
  TEMPORARY
  OTHER
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  DELETED
  EXPIRED
}

// Memory belonging to an end-user of a developer's application
model Memory {
  id             String @id @default(cuid())
  organizationId String
  projectId      String
  externalUserId String
  namespace      String @default("default")

  content String @db.Text

  // 1536 dimension vector for embeddings (e.g. text-embedding-3-small)
  embedding Unsupported("vector(1536)")?

  type   MemoryType   @default(FACT)
  status MemoryStatus @default(ACTIVE)

  importance Float @default(0.5)
  confidence Float @default(1.0)

  sourceType     String?
  sourceId       String?
  metadata       Json?
  lastAccessedAt DateTime?
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     MemoryVersion[]

  @@index([organizationId, projectId, externalUserId, status])
  @@index([projectId, externalUserId, namespace, status])
  @@index([projectId, status])
  @@index([expiresAt])
  @@map("memories")
}

// Historical audit log and superseded versions of memories
model MemoryVersion {
  id              String   @id @default(cuid())
  memoryId        String
  content         String   @db.Text
  previousContent String?  @db.Text
  changeReason    String?
  createdAt       DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("memory_versions")
}
